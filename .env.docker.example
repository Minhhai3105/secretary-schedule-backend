# Docker Compose setup: copy this file to .env in a fresh checkout.
# Do not overwrite an existing local .env; use --env-file .env.docker instead.
# Generate each secret separately: python3 -c 'import secrets; print(secrets.token_hex(32))'
DB_ADMIN_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

# Change to 8001 if another backend already uses port 8000.
API_PORT=8000
AUTH_COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_URL=http://localhost:5173

# CLIProxyAPI runs separately on the Mac, not inside the API container.
AI_BASE_URL=http://host.docker.internal:8317/v1
AI_API_KEY=
AI_MODEL=gemini-3.8-flash-high
AI_TIMEOUT_SECONDS=120

# Optional: password-reset and reminder emails need SMTP configuration.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=30
