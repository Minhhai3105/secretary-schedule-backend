# Copy to .env and replace placeholder values. Keep .env out of Git.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use 0 only for local HTTP; use 1 behind HTTPS.
AUTH_COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The backend calls the local LiteLLM gateway. Never expose its master key to the frontend.
AI_BASE_URL=http://127.0.0.1:4000/v1
AI_MODEL=secretary-schedule
AI_TIMEOUT_SECONDS=120
AI_API_KEY=replace-with-the-LITELLM_MASTER_KEY

# Required only for password-reset email.
APP_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
