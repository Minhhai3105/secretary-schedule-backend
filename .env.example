# Copy to .env and replace placeholder values. Keep .env out of Git.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Use 0 only for local HTTP; use 1 behind HTTPS.
AUTH_COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional chat provider settings; AI_API_KEY is required for chat requests.
AI_BASE_URL=http://127.0.0.1:8317/v1
AI_MODEL=gemini-3.8-flash-high
AI_TIMEOUT_SECONDS=60
AI_API_KEY=

# Required only for password-reset email.
APP_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
